GEMINI_API_KEY=
GROQ_API_KEY=
DATABASE_URL=postgresql://localhost:5432/portfolio
CHAT_ADMIN_SECRET=
CHAT_ALLOWED_ORIGINS=http://localhost:3000
CHAT_MODEL=gemini-2.0-flash
CHAT_EMBEDDING_MODEL=text-embedding-004
CHAT_MAX_INPUT_CHARS=4000
CHAT_MAX_OUTPUT_TOKENS=800
CHAT_RATE_LIMIT_PER_MINUTE=30
CHAT_ANALYTICS_RETENTION_DAYS=90
# Optional: only a Vercel proxy-overwritten, normalized identity header.
CHAT_TRUSTED_IDENTITY_HEADER=
# Server-only owner credential. Never expose this as NEXT_PUBLIC_* or send it in a URL.
# Set separately in Vercel Preview and Production environments.
